#!/usr/bin/env bash
# PartyMimic G1 FastTrack launcher.   bin/ft <command> [args]
#   sim-smoke               hanging sim, shadow mode, 2 s segment (host + runner, loopback)
#   sim-dance [--ground]    hanging (default) or ground sim, live, full clip
#   sim-faults [case...]    Sim2Sim safety-gate matrix
#   test                    unit tests
#   diag IFACE [args]       READ-ONLY real-robot diagnostics (S0). Never calls SwitchTo*/SetFsmId, never creates a publisher.
#                           extra: --probe-joint 10  (move one joint by hand), --entry-fsm N --write-pass  (= preflight)
#   diag-sim                the same diagnostics against the simulated host (needs tools/sim_host.py running)
#   preflight IFACE N       diag + write runs/preflight_pass.json; N = fsm id observed by `diag`
#   hang-hold IFACE N [ms]  S2/S2b: first SwitchToUserCtrl, hold pose only (<=3 s); optional command-silence test of ms (<=200)
#   hang-test IFACE N       S3: shadow (policy computed, NOT applied), 3 s segment
#   hang-live IFACE N       S4: policy applied at <=0.3 authority, 3 s segment
#   guardian IFACE          out-of-process guardian (own terminal, BEFORE hang-*)
#   estop [IFACE]           latch e-stop; with IFACE also take over directly (damp + SwitchToInternalCtrl)
#   estop-clear             remove the e-stop latch
# hang-* require: PARTYMIMIC_G1_ALLOW_MOTION gate (set by this script), fresh preflight file, running guardian,
# --i-confirm-hanging-and-estop (added here: ONLY run these commands once docs HANG_LIVE_ADMISSION.md section A is all checked).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${FT_PY:-$HERE/../../../sim2real_party_p0_patched/.venv/bin/python}"
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
cd "$HERE"
cmd="${1:-help}"; shift || true
case "$cmd" in
  sim-smoke)  exec "$PY" -B tools/sim_suite.py --name smoke --out runs/sim --runner="--mode shadow --segment-s 2 --auto-go" ;;
  sim-dance)
    if [[ "${1:-}" == "--ground" ]]; then H="--init frame0 --support none --oem-hold frozen"; N=ground; R="--prepare-s 0.1 --settle-s 0.02 --shadow-s 0.04 --ramp-in-s 0.1 --settle-tol-rad 0.3"
    else H="--init default --support hang --oem-hold pd"; N=hang; R=""; fi
    exec "$PY" -B tools/sim_suite.py --name "dance_$N" --out runs/sim --host="$H" --runner="--mode live --auto-go $R" ;;
  sim-faults) exec "$PY" -B tools/fault_suite.py "$@" ;;
  test)       PYTHONPATH="$HERE/.test_target" exec "$PY" -B -m pytest -q -p no:cacheprovider tests ;;
  diag)       : "${1:?IFACE}"; I="$1"; shift; exec "$PY" -B tools/diag.py --interface "$I" "$@" ;;
  diag-sim)   exec "$PY" -B tools/diag.py --interface lo --sim "$@" ;;
  preflight)  : "${1:?IFACE}" "${2:?observed fsm id N (from bin/ft diag)}"; exec "$PY" -B tools/diag.py --interface "$1" --entry-fsm "$2" --write-pass ;;
  hang-hold)  : "${1:?IFACE}" "${2:?N}"; export PARTYMIMIC_G1_ALLOW_MOTION=HANGING_SHORT_SEGMENT_ONLY
              exec "$PY" -B -m fasttrack.runner --target real --interface "$1" --entry-fsm "$2" --mode shadow --hold-only-s 3 --silence-test-ms "${3:-0}" --i-confirm-hanging-and-estop ;;
  hang-test)  : "${1:?IFACE}" "${2:?N}"; export PARTYMIMIC_G1_ALLOW_MOTION=HANGING_SHORT_SEGMENT_ONLY
              exec "$PY" -B -m fasttrack.runner --target real --interface "$1" --entry-fsm "$2" --mode shadow --segment-s 3 --i-confirm-hanging-and-estop ;;
  hang-live)  : "${1:?IFACE}" "${2:?N}"; export PARTYMIMIC_G1_ALLOW_MOTION=HANGING_SHORT_SEGMENT_ONLY
              exec "$PY" -B -m fasttrack.runner --target real --interface "$1" --entry-fsm "$2" --mode live --segment-s 3 --authority-max 0.3 --i-confirm-hanging-and-estop ;;
  guardian)   exec "$PY" -B -m fasttrack.guardian guardian --interface "${1:?IFACE}" ;;
  estop)      if [[ -n "${1:-}" ]]; then exec "$PY" -B -m fasttrack.guardian --interface "$1" --direct; else exec "$PY" -B -m fasttrack.guardian; fi ;;
  estop-clear) exec "$PY" -B -m fasttrack.guardian --clear ;;
  *) sed -n 2,26p "$0"; exit 1 ;;
esac
